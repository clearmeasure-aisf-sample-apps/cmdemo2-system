@startuml 02-azure-seed
!include _c4.iuml
title CM demo 2 multi-region | Phase 2: Azure seed (2026-10-05)

Boundary(box, "Operator machine omarchy") {
  Container(aiops, "Linux user aiops", "az as cm-ai-ops", "Ran new-demo-seed.ps1: seed.bicep at subscription scope, without a registry (the apps are zips in the Octopus feed)")
}

Boundary(sub, "Subscription Jeffrey MVP Azure subscription 7-25--7-27 (westus3)") {
  Boundary(rgn, "rg-cmdemo2-nonprod") {
    ContainerDb(tfstate, "stcmdemo2tf6hulrk", "Storage account", "Terraform state of octopus/ (container tfstate)", $tags="new")
    Container(id_plan, "id-cmdemo2-plan", "managed identity", "Reader on both groups: what-if previews and drift", $tags="new")
    Container(id_cfg, "id-cmdemo2-octopus-config", "managed identity", "Storage Blob Data Contributor on the state account", $tags="new")
    Container(id_dn, "id-cmdemo2-deploy-nonprod", "managed identity", "Owner of rg-cmdemo2-nonprod: applies the stacks of tdd, uat", $tags="new")
    Container(id_apps_n, "Runtime identities", "managed identities", "id-cmdemo2-tdd-app, id-cmdemo2-uat-app", $tags="new")
  }
  Boundary(rgp, "rg-cmdemo2-prod") {
    Container(id_dp, "id-cmdemo2-deploy-prod", "managed identity", "Owner of rg-cmdemo2-prod: applies the stacks of prod", $tags="new")
    Container(id_apps_p, "Runtime identities", "managed identities", "id-cmdemo2-prod-app", $tags="new")
  }
}

Boundary(gh, "GitHub org clearmeasure-aisf-sample-apps") {
  Container(sysrepo, "cmdemo2-system", "environments azure-read, octopus", $tags="planned")
}

Boundary(octo, "Octopus space cmdemo2 demo") {
  Container(projects, "Projects cmdemo2-system, cmdemo2-ui", "deployments per environment", "OIDC subjects space:cmdemo2-demo:project:<project>:environment:<env>", $tags="planned")
}

Rel(aiops, sub, "deployment seed-cmdemo2", "Owner", $tags="new")
Rel(sysrepo, id_plan, "federated: environment azure-read", $tags="planned")
Rel(sysrepo, id_cfg, "federated: environment octopus", $tags="planned")
Rel(projects, id_dn, "federated: nonprod environments", $tags="planned")
Rel(projects, id_dp, "federated: prod environments", $tags="planned")
Rel(id_cfg, tfstate, "state", $tags="new")

SHOW_LEGEND()
@enduml
